NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Readable logs in your terminal. Leave unset (JSON) anywhere else.
LOG_FORMAT=pretty

DATABASE_URL=postgres://raising_talents:raising_talents@localhost:5432/raising_talents
REDIS_URL=redis://localhost:6379

# Run `pnpm keys:generate` and paste the output here.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=
JWT_ISSUER=https://api.raisingtalents.app
JWT_AUDIENCE=raising-talents-app

# At least 32 random characters. Generate with: openssl rand -hex 32
VERIFICATION_CODE_PEPPER=

# Mailpit catches every email locally at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Raising Talents <no-reply@raisingtalents.app>

# Checks new passwords against the Have I Been Pwned range API.
BREACHED_PASSWORD_CHECK=true

# Observability. Both are off when empty, which is the normal setup on a laptop.
# OTLP over HTTP. Staging and production point at Grafana Cloud's OTLP gateway,
# with OTEL_EXPORTER_OTLP_HEADERS carrying the Grafana token.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Keep 1 in 10 traces in production: OTEL_TRACES_SAMPLER=parentbased_traceidratio, OTEL_TRACES_SAMPLER_ARG=0.1
SENTRY_DSN=

# Media. Locally, any S3-compatible server; on AWS, the staging bucket and CloudFront (no endpoint).
MEDIA_BUCKET=raising-talents-media-local
MEDIA_CDN_URL=http://localhost:4569/raising-talents-media-local
S3_ENDPOINT=http://localhost:4569
S3_FORCE_PATH_STYLE=true
# LocalStack accepts any credentials; the AWS SDK just needs some.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# development-allow-all approves every image so the pipeline runs without AWS. Refused in staging and production.
CONTENT_SCANNER=development-allow-all

# Video. disabled refuses video uploads. To try video locally, create a Mux
# environment, set VIDEO_PROVIDER=mux and fill in the MUX_ settings below.
# Webhooks need a public URL, for example a tunnel to http://localhost:3000/v1/webhooks/mux
VIDEO_PROVIDER=disabled
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY_BASE64=

# The web app (apps/web) runs on Vite's dev server. Plain http needs insecure cookies.
WEB_ORIGINS=http://localhost:5173
WEB_COOKIE_SECURE=false
