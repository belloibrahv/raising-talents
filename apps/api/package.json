{
  "name": "@rt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/main.api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main.worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/platform/database/migrate.ts",
    "keys:generate": "tsx scripts/generate-jwt-keys.ts",
    "lint": "eslint .",
    "db:check": "drizzle-kit check",
    "start": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@rt/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@rt/config": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
