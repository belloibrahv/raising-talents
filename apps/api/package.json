{
  "name": "@rt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/platform/database/migrate.ts",
    "keys:generate": "tsx scripts/generate-jwt-keys.ts",
    "search:rebuild": "tsx --env-file-if-exists=.env scripts/rebuild-search-index.ts",
    "staff:grant": "tsx --env-file-if-exists=.env scripts/grant-staff-role.ts",
    "account:reinstate": "tsx --env-file-if-exists=.env scripts/reinstate-account.ts",
    "storage:cors": "tsx --env-file-if-exists=.env scripts/configure-storage-cors.ts",
    "lint": "eslint .",
    "db:check": "drizzle-kit check",
    "start": "node --import ./dist/instrument.js dist/main.api.js",
    "start:worker": "node --import ./dist/instrument.js dist/main.worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1145.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-sesv2": "^3.1145.0",
    "@aws-sdk/s3-presigned-post": "^3.1145.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@rt/contracts": "workspace:*",
    "@sentry/node": "^11.2.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "import-in-the-middle": "3.5.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@rt/config": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
