        "operationId": "auth_signUp",
        "summary": "Create an account and start a session",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request. Codes: VALIDATION_FAILED.",
            "x-error-codes": [
              "VALIDATION_FAILED"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflict. Codes: EMAIL_ALREADY_REGISTERED.",
            "x-error-codes": [
              "EMAIL_ALREADY_REGISTERED"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request cannot be completed. Codes: UNDER_MINIMUM_AGE, WEAK_PASSWORD.",
            "x-error-codes": [
              "UNDER_MINIMUM_AGE",
              "WEAK_PASSWORD"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests. Codes: RATE_LIMITED.",
            "x-error-codes": [
              "RATE_LIMITED"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong. Codes: INTERNAL.",
            "x-error-codes": [
              "INTERNAL"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
