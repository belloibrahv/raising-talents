{
  "openapi": "3.1.0",
  "info": {
    "title": "Raising Talents API",
    "version": "0.0.0",
    "description": "Generated from @rt/contracts. Errors use RFC 9457 problem details; choose behaviour by the `code` field, never the message."
  },
  "servers": [
    {
      "url": "https://api.raisingtalents.app",
      "description": "Production"
    },
    {
      "url": "https://api.staging.raisingtalents.app",
      "description": "Staging"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Accounts, sessions and email verification"
    },
    {
      "name": "Me",
      "description": "The signed-in account"
    }
